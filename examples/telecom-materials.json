{
 "scenario": "telecom-demo",
 "materials": [
  {
   "id": "telecom-connectivity-runbook",
   "kind": "procedure",
   "content": {
    "roaming": "When a customer is abroad with roaming disabled, use the approved safe roaming capability.",
    "airplane_mode": "When airplane mode remains enabled and blocks service, use the approved safe reset capability.",
    "sim": "When SIM registration is invalid, run the approved safe SIM diagnostics capability.",
    "compound": "Combined conditions require every matching safe action; do not hide multi-step work behind one invented capability."
   },
   "metadata": {
    "source": "AgentFit maintained demo scenario pack",
    "owner": "network-operations"
   }
  },
  {
   "id": "telecom-human-boundary",
   "kind": "policy",
   "content": {
    "vip_contract_dispute": "Do not change service state automatically when a VIP account also has a contract dispute. Escalate to the customer-service duty owner.",
    "default": "Use only capabilities present in the approved inventory."
   },
   "metadata": {
    "source": "AgentFit maintained demo scenario pack",
    "owner": "customer-service-governance"
   }
  },
  {
   "id": "telecom-evaluation-policy",
   "kind": "acceptance-policy",
   "content": {
    "identity": "Every result is identified by CandidateRef, SampleRef and RunIndex.",
    "leakage": "Expected actions are evaluator-only and must not be sent to the Candidate Worker.",
    "execution_error": "Runtime failures are ERROR and must not be attributed to L1-L4."
   },
   "metadata": {
    "source": "AgentFit maintained demo scenario pack",
    "owner": "agentfit-validation"
   }
  }
 ],
 "capabilities": {
