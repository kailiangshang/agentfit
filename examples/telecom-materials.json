    ],
    "description": "Safely run SIM diagnostics"
   },
   {
    "id": "safe_escalate_human",
    "wraps": [
     "escalate_human"
    ],
    "description": "Escalate without changing service state",
    "human_gate": {
     "condition": "always",
     "reviewer": "customer-service-duty",
     "on_timeout": "block"
    }
   }
  ]
