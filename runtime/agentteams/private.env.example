# Copy to ../../.local-demo/agentteams/private.env and run chmod 600 on it.
# Never commit the populated private file. This may point to an internal
# LiteLLM gateway or directly to any OpenAI-compatible provider.
# Direct DeepSeek example (do not put the real key in this tracked file):
# AGENTTEAMS_OPENAI_BASE_URL='https://api.deepseek.com/v1'
# AGENTTEAMS_DEFAULT_MODEL='deepseek-chat'
AGENTTEAMS_LLM_API_KEY='<openai-compatible-api-key>'
AGENTTEAMS_OPENAI_BASE_URL='<openai-compatible-base-url>'
AGENTTEAMS_DEFAULT_MODEL='<manager-model-id>'
